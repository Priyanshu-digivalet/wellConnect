# Application
NODE_ENV=development
PORT=3000
REQUEST_BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Works with Docker Compose, any local Postgres, or Supabase.
# Only this variable is read for the database connection.
DATABASE_URL=postgresql://wellconnect:wellconnect@localhost:5432/wellconnect?schema=public

# JWT authentication abstraction. Replace the dev token issuer with the host app auth later.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Enables POST /api/v1/auth/dev-token. Keep false outside local development.
AUTH_DEV_MODE=true

# When true, recommendations are generated by the deterministic demo provider.
# The API does not call OpenAI. Required for running without an AI key.
DEMO_MODE=true

# AI provider selection. Used only when DEMO_MODE=false.
# Business logic reads the model from this variable and does not hardcode it.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Cloud Messaging. Leave blank to keep notifications stored but unsent.
# Never ship these values in the mobile app.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notification policy
QUIET_HOURS_START=22
QUIET_HOURS_END=7
RECOMMENDATION_COOLDOWN_HOURS=20
NOTIFICATION_COOLDOWN_HOURS=4
RECOMMENDATION_TTL_HOURS=24
